# Copy to .env and fill in. Secrets are passed at runtime only (docker compose env_file), never baked into the image.
MAX_FILE_SIZE_MB=10
MAX_PAGES=40
# Required: the service does not start without it. At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=
# Local development only: accept requests without a token.
# AUTH_DISABLED=true

# Open-source model (Qwen3-VL) on an OpenAI-compatible server; docker-compose.yml sets LLM_BASE_URL and LLM_MODEL.
# auto = page image to the model only for photos/scans (OCR); on | off to force
LLM_VISION=auto
# LLM_API_KEY=   only if the model server requires one

OCR_LANG=pol
