# Copy to .env and fill in.
# Secrets reach the container at runtime only (compose env_file), never through the image.
MAX_FILE_SIZE_MB=10
MAX_PAGES=40
# JWT_SECRET is required; the service does not start without it.
# Use at least 32 random characters, e.g. `openssl rand -hex 32`.
# The quick start in README.md appends it to .env.
JWT_ALGORITHM=HS256
JWT_AUDIENCE=
# Local development only: accept requests without a token.
# AUTH_DISABLED=true

# Open-weights model (Qwen3-VL) on an OpenAI-compatible server.
# docker-compose.yml sets LLM_BASE_URL and LLM_MODEL.
# auto sends page images to the model only for photos and scans; on | off forces it.
LLM_VISION=auto
# LLM_API_KEY=   only if the model server requires one
# EDENAI_API_KEY=   for docker-compose.edenai.yml (the model through Eden AI)

OCR_LANG=pol
